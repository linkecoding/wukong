<resources>
    <style name="Theme.Wukong" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>
    <style name="Theme.Wukong.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="android:buttonBarButtonStyle">@style/Wukong.DialogButton</item>
        <item name="android:textAppearanceMedium">@style/Wukong.DialogBody</item>
    </style>
    <style name="Wukong.DialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Wukong.DialogBody" parent="android:style/TextAppearance.Material.Medium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
</resources>
